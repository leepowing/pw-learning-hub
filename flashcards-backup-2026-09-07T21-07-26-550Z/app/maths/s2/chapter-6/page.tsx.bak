          line-height: 1.12;
        }

        .introduction {
          max-width: 920px;
          margin: 0 0 30px;
          color: #64748b;
          font-size: 19px;
          line-height: 1.65;
        }

        .overviewCard {
          display: flex;
          align-items: center;
          gap: 22px;
          margin-bottom: 20px;
          padding: 25px 27px;
          border: 1px solid #ddd6fe;
          border-radius: 22px;
          background: linear-gradient(135deg, #f5f3ff, #eef2ff);
          box-shadow: 0 6px 18px rgba(124, 58, 237, 0.06);
        }

        .overviewIcon {
          width: 74px;
          height: 74px;
          display: flex;
          align-items: center;
          justify-content: center;
          flex-shrink: 0;
          border-radius: 21px;
          background: #ede9fe;
          color: #6d28d9;
          font-family: "Times New Roman", serif;
          font-size: 42px;
          font-weight: 900;
        }

        .overviewLabel,
        .keyIdeasLabel,
        .theoremPreviewLabel {
          margin: 0 0 6px;
          color: #6d28d9;
        }

