"use client";

import { useRouter } from "next/navigation";

const sections = [
  {
    number: 1,
    title: "Introduction to Deductive Reasoning",
    description:
      "Understand hypotheses, conclusions and the logical structure used to prove a mathematical statement.",
    route: "/maths/s2/chapter-6/introduction-to-deductive-reasoning",
    available: true,
  },
  {
    number: 2,
    title: "Proofs Relating to Intersecting and Parallel Lines",
    description:
      "Use angle relationships and their converses to justify results involving intersecting and parallel lines.",
    route:
      "/maths/s2/chapter-6/proofs-relating-to-intersecting-and-parallel-lines",
    available: true,
  },
  {
    number: 3,
    title: "Proofs Relating to Triangles",
    description:
      "Apply the angle sum and exterior-angle theorems of a triangle in clear deductive proofs.",
    route: "/maths/s2/chapter-6/proofs-relating-to-triangles",
    available: true,
  },
  {
    number: 4,
    title: "Euclid and Elements",
    description:
      "Explore Euclid's contribution to geometry and how definitions, axioms and theorems form a deductive system.",
    route: "/maths/s2/chapter-6/euclid-and-elements",
    available: true,
  },
];

export default function S2ChapterSixHomepage() {
  const router = useRouter();

  return (
    <main className="page">
      <button
        type="button"
        className="backButton"
        onClick={() => router.push("/maths/s2")}
      >
        ← Back to S2 Mathematics
      </button>

      <p className="eyebrow">S2 MATHEMATICS</p>

      <h1>Chapter 6 · Angles and Parallel Lines (II)</h1>

      <p className="introduction">
        Develop deductive reasoning and learn to write clear geometric proofs
        using established angle relationships, parallel-line theorems and
        triangle theorems.
      </p>

      <section className="overviewCard">
        <div className="overviewIcon" aria-hidden="true">
          ∠
        </div>

        <div>
          <p className="overviewLabel">CHAPTER OVERVIEW</p>
          <h2>From angle facts to mathematical proof</h2>
          <p>
            This chapter turns familiar angle relationships into logical
            arguments. Every conclusion must follow from a given fact, a
            theorem or an earlier step in the proof.
          </p>
        </div>
      </section>

      <section className="keyIdeasCard">
        <p className="keyIdeasLabel">KEY IDEAS</p>

        <div className="keyIdeasGrid">
          <article>
            <span className="ideaNumber">1</span>
            <div>
              <strong>State a reason</strong>
              <p>
                Support every important statement with a given condition or
                an established theorem.
              </p>
            </div>
          </article>

          <article>
            <span className="ideaNumber">2</span>
            <div>
              <strong>Use the converse carefully</strong>
              <p>
                Equal corresponding or alternate angles, or supplementary
                interior angles, can be used to prove that lines are parallel.
              </p>
            </div>
          </article>

          <article>
            <span className="ideaNumber">3</span>
            <div>
              <strong>Build proofs step by step</strong>
              <p>
                Start from the given information and connect each justified
                result until the required conclusion is reached.
              </p>
            </div>
          </article>
        </div>
      </section>

      <section className="sectionGrid">
        {sections.map((section) => (
          <article key={section.number} className="sectionCard">
            <div className="sectionTop">
              <span className="sectionNumber">{section.number}</span>

              <span
                className={
                  section.available
                    ? "sectionStatus availableStatus"
                    : "sectionStatus"
                }
              >
                {section.available ? "Available" : "Coming soon"}
              </span>
            </div>

            <p className="sectionLabel">SECTION {section.number}</p>
            <h2>{section.title}</h2>
            <p className="sectionDescription">{section.description}</p>

            {section.available ? (
              <button
                type="button"
                className="startSectionButton"
                onClick={() => router.push(section.route)}
              >
                Start Section {section.number} →
              </button>
            ) : (
              <button
                type="button"
                className="disabledSectionButton"
                disabled
              >
                Coming soon
              </button>
            )}
          </article>
        ))}
      </section>

      <section className="theoremPreviewCard">
        <div>
          <p className="theoremPreviewLabel">THEOREM PREVIEW</p>
          <h2>Reasons used in geometric proofs</h2>
          <p>
            These relationships will be explained, illustrated and applied in
            Sections 2 and 3.
          </p>
        </div>

        <div className="theoremPreview">
          <span>Adjacent angles on a straight line add up to 180°.</span>
          <span>Vertically opposite angles are equal.</span>
          <span>Angles at a point add up to 360°.</span>
          <span>Alternate angles are equal when the lines are parallel.</span>
          <span>Corresponding angles are equal when the lines are parallel.</span>
          <span>
            Interior angles on the same side of a transversal add up to 180° when the lines are parallel.
          </span>
          <span>The interior angles of a triangle add up to 180°.</span>
          <span>
            An exterior angle of a triangle equals the sum of the two opposite
            interior angles.
          </span>
        </div>
      </section>

      <section className="featureCard flashcardCard">
        <div>
          <p className="featureLabel flashcardLabel">GEOMETRY REVIEW</p>
          <h2>Chapter 6 Flashcards</h2>
          <p>
            Practise theorem statements, standard proof reasons and the
            converses used to establish parallel lines.
          </p>
        </div>

        <button type="button" className="disabledFeatureButton" disabled>
          Coming soon
        </button>
      </section>

      <section className="featureCard checkpointCard">
        <div>
          <p className="featureLabel checkpointLabel">FINAL ACTIVITY</p>
          <h2>Chapter 6 Checkpoint</h2>
          <p>Complete Sections 1–4 before attempting the checkpoint.</p>
        </div>

        <button type="button" className="startCheckpointButton" onClick={() => router.push("/maths/s2/chapter-6/checkpoint")}>
          Start Checkpoint →
        </button>
      </section>

      <style jsx>{`
        .page {
          max-width: 1120px;
          width: calc(100% - 48px);
