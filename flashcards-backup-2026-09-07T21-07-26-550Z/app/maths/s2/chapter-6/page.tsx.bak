          color: #64748b;
          font-size: 17px;
          line-height: 1.55;
        }

        .keyIdeasCard {
          margin-bottom: 24px;
          padding: 25px;
          border: 1px solid #c4b5fd;
          border-radius: 22px;
          background: #ffffff;
        }

        .keyIdeasGrid {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 16px;
